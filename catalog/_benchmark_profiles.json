          "languages": "english-if-supported",
          "quants": "all-downloads",
          "batch_size": 8,
          "sort_by_length": true,
          "timestamps": "none",
          "gpu": "L40S",
          "backend": "cuda"
        },
        {
          "dataset": "fleurs",
          "split": "test",
          "languages": "supported-intersect-fleurs",
          "quants": [
            "Q8_0"
          ],
          "batch_size": 8,
          "sort_by_length": true,
          "timestamps": "none",
          "gpu": "L40S",
          "backend": "cuda"
        }
      ],
      "speed": {
        "quants": [
