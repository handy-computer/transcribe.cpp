+static int ggml_backend_cpu_x86_score() {
+    cpuid_x86 is;
+    // xgetbv is only valid when the OS has set CR4.OSXSAVE
+    const uint64_t xcr0 = is.OSXSAVE() ? ggml_x86_xgetbv0() : 0;
+    return ggml_backend_cpu_x86_score_xcr0(is, xcr0);
+}
