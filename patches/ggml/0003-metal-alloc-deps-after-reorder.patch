+
+    // keep the MoE weighted-reduction inputs alive until the fused output so the
+    // allocator cannot reuse them while the fused kernel is still reading them.
+    // this must run on the final (reordered) node order: the raw pattern match is
+    // by op type only, so the `until` node need not depend on the kept tensors, and
+    // a reorder can move it ahead of their producers. a dep placed there would make
+    // the allocator pre-allocate (and possibly in-place reuse) a tensor before it
+    // is computed
+    ggml_metal_fusion_add_alloc_deps(params->user_data, params->add_alloc_dep, cgraph);
